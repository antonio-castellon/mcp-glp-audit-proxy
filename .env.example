# Stdio identity. The host process must set these to the authenticated human.
GLP_PRINCIPAL_ID=operator-1
GLP_PRINCIPAL_NAME=Ada Analyst
GLP_PRINCIPAL_ROLE=operator

# Optional overrides. Relative audit and licence paths resolve against the config file.
GLP_CONFIG=config.json
GLP_AUDIT_PATH=
GLP_FAIL_CLOSED=true
GLP_REQUIRE_NTP=false
GLP_LICENCE_PATH=
